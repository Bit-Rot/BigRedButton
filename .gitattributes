# --- Text / line-ending normalization ---
# Default: let git auto-detect, normalize to LF in the repo (cross-platform ready).
* text=auto eol=lf

# Source code: explicit LF (cross-platform, AI tooling friendly).
*.cpp text eol=lf
*.h   text eol=lf
*.hpp text eol=lf
*.cs  text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.md  text eol=lf
*.sh  text eol=lf
*.py  text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
# UE project / plugin descriptors: text + union merge to reduce module-array conflicts.
*.uproject text eol=lf merge=union
*.uplugin  text eol=lf merge=union
# Windows-only batch files keep CRLF (cmd.exe is picky).
*.bat text eol=crlf
*.cmd text eol=crlf
# --- LFS content tracking ---
# NOTE: Once collaborators join, switch .umap (and per-policy, .uasset) to
# `lockable` and require `git lfs lock` before edit. Maps can't merge cleanly.
Game/Content/** filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
Assets/** filter=lfs diff=lfs merge=lfs -text
